// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  nome        String
  email       String   @unique
  senha       String
  descricao   String?
  fotoPerfil  String?
  createdAt   DateTime @default(now())

  projetos          Project[]
  curtidas          ProjectLike[]
  comunidadesCriadas Community[]       @relation("CommunityCreator")
  participacoes     CommunityMember[]
  postsComunidade CommunityPost[] @relation("CommunityPostAuthor")
  notificacoes    Notification[]
  preferenciasNotificacao NotificationPreference?
}

model Project {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String
  statusAprovacao String @default("APROVADO")
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Restrict)

  etapas ProjectStep[]
  midias ProjectMedia[]
  curtidas ProjectLike[]

  @@index([communityId])
}

model ProjectLike {
  projectId Int
  userId    Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectStep {
  id        Int       @id @default(autoincrement())
  titulo    String
  conteudo  String
  ordem     Int
  createdAt DateTime  @default(now())

  projectId Int
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  midias    ProjectMedia[]
}

model ProjectMedia {
  id        Int          @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  createdAt DateTime     @default(now())

  projectId Int
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  stepId    Int?
  step     ProjectStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model Community {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  tipoEntrada String   @default("LIVRE")
  createdAt   DateTime @default(now())

  creatorId   Int
  creator     User     @relation("CommunityCreator", fields: [creatorId], references: [id])

  membros     CommunityMember[]
  posts       CommunityPost[]
  projetos    Project[]
}

model CommunityMember {
  id                     Int      @id @default(autoincrement())
  status                 String   @default("APROVADO")
  statusContribuicao     String   @default("NAO_SOLICITADO")
  createdAt              DateTime @default(now())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  communityId Int
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model CommunityPost {
  id          Int      @id @default(autoincrement())
  titulo      String
  conteudo    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    Int
   author User @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  communityId Int
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  midias CommunityPostMedia[]
}

model CommunityPostMedia {
  id        Int      @id @default(autoincrement())
  nome      String
  tipo      String
  url       String
  createdAt DateTime @default(now())

  postId Int
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  tipo      String
  titulo    String
  mensagem  String
  link      String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida, createdAt])
}

model NotificationPreference {
  id          Int     @id @default(autoincrement())
  projetos    Boolean @default(true)
  comunidades Boolean @default(true)
  permissoes  Boolean @default(true)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
